generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["education"]
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  role_id       String
  password_hash String
  career_goal   String?        
  status        String         @default("active")
  last_login    DateTime?
  created_at    DateTime       @default(now())

  role            Role             @relation(fields: [role_id], references: [id])
  profile         Profile?
  assessments     Assessment[]
  gapReports      GapReport[]
  enrollments     Enrollment[]
  jobs            Job[]            @relation("EmployerJobs")
  applications    Application[]
  notifications   Notification[]
  subscriptions   Subscription[]
  taughtCourses   Course[]         @relation("EducatorCourses")
  progress        Progress[]
  certificates    Certificate[]
  achievements    Achievement[]
  tasks           Task[]
  recommendations Recommendation[]
  announcements   Announcement[]   @relation("EducatorAnnouncements")
  authOtps        AuthOtp[]
  refreshTokens   RefreshToken[]
  quizSessions    QuizSession[]

  @@index([role_id])
  @@map("users")
  @@schema("education")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // student | educator | employer | admin
  description String?
  created_at  DateTime         @default(now())

  users       User[]
  permissions RolePermission[]

  @@map("roles")
  @@schema("education")
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique // e.g. "courses:create"
  description String?
  category    String?          // grouping (e.g. "Courses", "Admin")
  created_at  DateTime         @default(now())

  roles RolePermission[]

  @@map("permissions")
  @@schema("education")
}

model RolePermission {
  role_id       String
  permission_id String
  assigned_at   DateTime @default(now())

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@map("role_permissions")
  @@schema("education")
}

model Profile {
  id           String  @id @default(uuid())
  user_id      String  @unique
  career_goal  String?
  institution  String?
  company      String?
  preferences  Json?
  initial_assessment_completed Boolean  @default(false)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("profiles")
  @@schema("education")
}

model Assessment {
  id         String   @id @default(uuid())
  user_id    String
  type       String
  score      Float
  answers    Json?
  date_taken DateTime @default(now())
  career_goal   String?
  is_initial    Boolean   @default(false)
  total_marks   Int?
  obtained_marks Int?
  completed     Boolean   @default(false)
  started_at    DateTime?
  completed_at  DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("assessments")
  @@schema("education")
}

model GapReport {
  id               String   @id @default(uuid())
  user_id          String
  readiness_score  Float
  missing_skills   String[]
  recommendations  Json?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("gap_reports")
  @@schema("education")
}

model Course {
  id          String   @id @default(uuid())
  title       String
  description String?
  provider    String?
  category    String?
  difficulty  String?  // beginner | intermediate | advanced
  status      String   @default("active") // active | draft | archived
  educator_id String?
  created_at  DateTime @default(now())

  educator        User?            @relation("EducatorCourses", fields: [educator_id], references: [id], onDelete: SetNull)
  enrollments     Enrollment[]
  lessons         Lesson[]
  certificates    Certificate[]
  tasks           Task[]
  recommendations Recommendation[]

  @@map("courses")
  @@schema("education")
}

model Enrollment {
  id                    String   @id @default(uuid())
  user_id               String
  course_id             String
  status                String   @default("active")
  completion_percentage Float    @default(0)
  enrolled_at           DateTime @default(now())

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course Course @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@unique([user_id, course_id])
  @@map("enrollments")
  @@schema("education")
}

model Job {
  id              String   @id @default(uuid())
  employer_id     String
  title           String
  description     String?
  requirements    String?
  required_skills String[]
  status          String   @default("open")
  created_at      DateTime @default(now())

  employer     User          @relation("EmployerJobs", fields: [employer_id], references: [id], onDelete: Cascade)
  applications Application[]

  @@map("jobs")
  @@schema("education")
}

model Application {
  id          String   @id @default(uuid())
  job_id      String
  student_id  String
  status      String   @default("submitted")
  skill_match Float?
  applied_at  DateTime @default(now())

  job     Job  @relation(fields: [job_id], references: [id], onDelete: Cascade)
  student User @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([job_id, student_id])
  @@map("applications")
  @@schema("education")
}

model Notification {
  id          String   @id @default(uuid())
  user_id     String
  type        String
  message     String
  read_status Boolean  @default(false)
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notifications")
  @@schema("education")
}

model Subscription {
  id         String   @id @default(uuid())
  user_id    String
  plan_type  String
  start_date DateTime
  end_date   DateTime

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("subscriptions")
  @@schema("education")
}

model Report {
  id          String   @id @default(uuid())
  title       String
  type        String   // enrollment | assessment | activity | satisfaction | custom
  generated_at DateTime @default(now())
  exported_at DateTime?
  format      String?  // pdf | csv
  payload     Json?

  @@map("reports")
  @@schema("education")
}

model Setting {
  id     String @id @default(uuid())
  scope  String @default("system")  // system | tenant | user
  key    String
  value  Json

  @@unique([scope, key])
  @@map("settings")
  @@schema("education")
}

model Lesson {
  id          String   @id @default(uuid())
  course_id   String
  title       String
  video_url   String?
  duration    Int?     // minutes
  order_index Int      @default(0)
  created_at  DateTime @default(now())

  course      Course       @relation(fields: [course_id], references: [id], onDelete: Cascade)
  quizzes     Quiz[]
  assignments Assignment[]
  progress    Progress[]

  @@map("lessons")
  @@schema("education")
}

model Quiz {
  id            String @id @default(uuid())
  lesson_id     String
  questions     Json
  passing_score Int    @default(60)

  lesson Lesson @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@map("quizzes")
  @@schema("education")
}

model Assignment {
  id              String   @id @default(uuid())
  lesson_id       String
  instructions    String?
  submission_link String?
  created_at      DateTime @default(now())

  lesson Lesson @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@map("assignments")
  @@schema("education")
}

model Progress {
  id                String   @id @default(uuid())
  user_id           String
  lesson_id         String
  watched_duration  Int      @default(0)
  quiz_score        Int?
  assignment_status String   @default("pending")
  completion_flag   Boolean  @default(false)

  completed_at      DateTime?

  updated_at        DateTime @updatedAt

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@unique([user_id, lesson_id])
  @@map("progress")
  @@schema("education")
}

model Certificate {
  id               String   @id @default(uuid())
  user_id          String
  course_id        String
  certificate_code String   @unique
  issued_date      DateTime @default(now())

  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course       Course        @relation(fields: [course_id], references: [id], onDelete: Cascade)
  achievements Achievement[]

  @@map("certificates")
  @@schema("education")
}

model Achievement {
  id             String   @id @default(uuid())
  user_id        String
  badge_name     String
  milestone      String?
  certificate_id String?
  earned_at      DateTime @default(now())

  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  certificate Certificate? @relation(fields: [certificate_id], references: [id], onDelete: SetNull)

  @@map("achievements")
  @@schema("education")
}

model Task {
  id        String    @id @default(uuid())
  user_id   String
  course_id String?
  title     String
  due_date  DateTime?
  status    String    @default("pending") // pending | done
  created_at DateTime  @default(now())

  user   User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [course_id], references: [id], onDelete: SetNull)

  @@map("tasks")
  @@schema("education")
}

model Recommendation {
  id         String   @id @default(uuid())
  user_id    String
  course_id  String
  reason     String?
  created_at DateTime @default(now())

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course Course @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@map("recommendations")
  @@schema("education")
}

model Announcement {
  id            String    @id @default(uuid())
  educator_id   String
  title         String
  message       String
  audience      String    @default("all") // all | course | educators
  scheduled_at  DateTime?
  attachment    String?
  created_at    DateTime  @default(now())

  educator User @relation("EducatorAnnouncements", fields: [educator_id], references: [id], onDelete: Cascade)

  @@map("announcements")
  @@schema("education")
}


model AuthOtp {
  id          String   @id @default(uuid())
  user_id     String   @unique
  otp_hash    String
  expires_at  DateTime
  verified_at DateTime?
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("auth_otps")
  @@schema("education")
}

model RefreshToken {
  id          String   @id @default(uuid())
  user_id     String
  token_hash  String
  expires_at  DateTime
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])

  @@map("refresh_tokens")
  @@schema("education")
}

model DomainRole {
  id          Int      @id @default(autoincrement())
  domain_name String   @unique
  category    String?
  created_at  DateTime @default(now())

  requiredSkills DomainRequiredSkill[]
  quizSessions  QuizSession[]

  @@map("domain_roles")
  @@schema("education")
}

model Skill {
  id          Int      @id @default(autoincrement())
  skill_name  String   @unique
  category    String?
  description String?
  created_at  DateTime @default(now())

  requiredForDomains DomainRequiredSkill[]
  questions          Question[]
  answers            StudentAnswer[]
  skillResults       StudentSkillResult[]

  @@map("skills")
  @@schema("education")
}

model DomainRequiredSkill {
  id             Int      @id @default(autoincrement())
  domain_role_id Int
  skill_id       Int
  required_level Int
  created_at     DateTime @default(now())

  domainRole DomainRole @relation(fields: [domain_role_id], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@unique([domain_role_id, skill_id])

  @@map("domain_required_skills")
  @@schema("education")
}

model DifficultyLevel {
  id               Int    @id @default(autoincrement())
  difficulty_name  String @unique
  difficulty_order Int    @unique

  questions Question[]
  answers   StudentAnswer[]

  @@map("difficulty_levels")
  @@schema("education")
}

model Question {
  id             Int      @id @default(autoincrement())
  skill_id       Int
  difficulty_id  Int
  question_text  String
  option_a       String
  option_b       String
  option_c       String
  option_d       String
  correct_option String
  marks          Int      @default(1)
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())

  skill      Skill           @relation(fields: [skill_id], references: [id])
  difficulty DifficultyLevel @relation(fields: [difficulty_id], references: [id])

  answers StudentAnswer[]

  @@map("questions")
  @@schema("education")
}

model QuizSession {
  id                  Int      @id @default(autoincrement())
  user_id             String   @db.Uuid
  domain_role_id      Int
  start_time          DateTime @default(now())
  end_time            DateTime?
  status              String   @default("In Progress")
  total_questions     Int      @default(50)
  questions_answered  Int      @default(0)
  created_at          DateTime @default(now())

  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  domainRole DomainRole @relation(fields: [domain_role_id], references: [id], onDelete: Restrict)

  answers      StudentAnswer[]
  skillResults StudentSkillResult[]

  @@map("quiz_sessions")
  @@schema("education")
}

model StudentAnswer {
  id               Int      @id @default(autoincrement())
  session_id       Int
  skill_id         Int
  question_id      Int
  difficulty_id    Int
  selected_option  String
  correct_option   String
  is_correct       Boolean
  marks_awarded    Int      @default(0)
  answered_at      DateTime @default(now())

  session    QuizSession     @relation(fields: [session_id], references: [id], onDelete: Cascade)
  skill      Skill           @relation(fields: [skill_id], references: [id], onDelete: Restrict)
  question   Question        @relation(fields: [question_id], references: [id], onDelete: Restrict)
  difficulty DifficultyLevel @relation(fields: [difficulty_id], references: [id], onDelete: Restrict)

  @@map("student_answers")
  @@schema("education")
}

model StudentSkillResult {
  id              Int      @id @default(autoincrement())
  session_id      Int
  skill_id        Int
  obtained_score  Int
  maximum_score   Int
  percentage      Decimal  @db.Decimal(5, 2)
  skill_level     Int
  created_at      DateTime @default(now())

  session QuizSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  skill   Skill       @relation(fields: [skill_id], references: [id], onDelete: Restrict)

  @@map("student_skill_results")
  @@schema("education")
}
