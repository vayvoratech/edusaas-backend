{
  "name": "edu-saas-backend",
  "version": "1.0.0",
  "description": "EDU-SAAS backend API",
  "main": "server.js",
  "scripts": {
    "start": "cross-env APP_ENV=stage node server.js",
    "start:dev": "cross-env APP_ENV=dev node server.js",
    "start:stage": "cross-env APP_ENV=stage node server.js",
    "dev": "cross-env APP_ENV=dev nodemon server.js",
    "dev:stage": "cross-env APP_ENV=stage nodemon server.js",
    "db:generate": "prisma generate",
    "db:migrate:stage": "dotenv -e .env.stage -- prisma migrate dev",
    "db:seed:stage": "dotenv -e .env.stage -- prisma db seed",
    "db:studio:stage": "dotenv -e .env.stage -- prisma studio",
    "db:push:stage": "dotenv -e .env.stage -- prisma db push",
    "db:seed": "node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "prisma": "^6.19.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "dotenv-cli": "^11.0.0",
    "nodemon": "^3.1.4"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
